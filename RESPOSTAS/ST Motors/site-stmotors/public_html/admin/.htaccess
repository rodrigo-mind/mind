# Bloqueia listagem de diretório
Options -Indexes

# NOTA: a proteção de acesso ao admin é feita pelo guard.php (PHP), não aqui.
# "Require all granted" abaixo só mantém o Apache servindo os .php normalmente —
# não é controle de acesso.
<FilesMatch "\.(php)$">
  <RequireAll>
    Require all granted
  </RequireAll>
</FilesMatch>

# Headers de segurança — o admin é onde clickjacking dói mais (sessão logada)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
